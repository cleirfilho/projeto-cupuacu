PORT=3000
DATABASE_PATH=backend/database.sqlite
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:4200
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# SMTP para o formulário de contato
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=formulario@example.com
SMTP_PASS=change-me
CONTACT_FROM=formulario@example.com
CONTACT_TO=contato@example.com

# APIs RTC na rede interna do Dev Container
RTC_REGIME_REGULAR_URL=http://rtc-regime-regular:8080/api
RTC_SIMPLES_NACIONAL_URL=http://rtc-simples-nacional:8082/api
RTC_DANFSE_URL=http://rtc-danfse:8080

# Blog. Monte o diretório de mídias em um volume persistente e faça backup junto com o SQLite.
# BLOG_MEDIA_PATH=backend/blog-media
# BLOG_VIEW_SECRET=replace-with-a-random-secret
# Configure apenas atrás de uma cadeia de proxies controlada.
BLOG_TRUST_PROXY_HOPS=0
# Origem pública e endereço interno da API para o processo Angular SSR.
# BLOG_SITE_URL=https://www.example.com
BLOG_API_ORIGIN=http://localhost:3000
